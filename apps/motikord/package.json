{
  "name": "motikord",
  "description": "Short animated clips, made on your computer",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
