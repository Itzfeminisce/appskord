    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@appskord/llm": "workspace:*",
    "@appskord/media": "workspace:*",
    "@appskord/motion": "workspace:*",
