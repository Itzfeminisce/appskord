    "bezier-easing": "3.2.0",
    "flubber": "0.4.2",
    "mediabunny": "1.65.2",
    "opentype.js": "2.0.0",
    "postprocessing": "6.39.6",
    "three": "0.187.0",
    "three.quarks": "0.17.1",
    "troika-three-text": "0.53.1"
  },
  "devDependencies": {
    "@appskord/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/three": "0.187.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
